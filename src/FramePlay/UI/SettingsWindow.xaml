<Window x:Class="FramePlay.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FramePlay.Localization"
        Title="{l:Tr settings.title}" Width="920" Height="660" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg2Brush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" Icon="/Assets/FramePlay.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Background="{DynamicResource Bg1Brush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,0,14">
                    <Image Source="/Assets/FramePlay-256.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{l:Tr settings.title}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextStrongBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="Nav" Margin="10,0,10,10" SelectionChanged="Nav_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <Button Style="{StaticResource CloseWindowButton}" Content="{StaticResource Icon.Close}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
            <ScrollViewer x:Name="Scroll" Margin="0,44,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Page" Margin="34,0,34,34" MaxWidth="780" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
            <Border x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Padding="14,8" Visibility="Collapsed"
                    Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource MenuLineBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadius}">
                <TextBlock x:Name="NoticeText" Foreground="{DynamicResource TextStrongBrush}" TextWrapping="Wrap" MaxWidth="520"/>
            </Border>
        </Grid>
    </Grid>
</Window>
